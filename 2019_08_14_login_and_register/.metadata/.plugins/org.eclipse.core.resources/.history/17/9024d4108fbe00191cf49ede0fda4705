<div id="fullscreen_bg" class="fullscreen_bg"/ ng-cloak ng-app="MyApp">


<div style="display:none;background:rgba(0,0,0,0.1); height:100%;">


	<form name="form" ng-submit="vm.login()" role="form" class="form-signin" style="text-align: center; position:absolute; top:40%; left:50%; -ms-transform: translateX(-50%) translateY(-50%);
  -webkit-transform: translate(-50%,-50%); transform: translate(-50%,-50%);">

		<h1 style="font-family: Alegreya SC; color: #FF7C00; font-size: 70px; margin-bottom: -10px;">Sign In</h1>
		<input type="text" name="email" id="email" class="form-control" placeholder="Enter Email" ng-model="vm.email" required="" autofocus=""><br>
		<span ng-show="form.email.$dirty && form.email.$error.required" class="help-block">Email is required</span><br>
		<input type="password" name="password" id="password" class="form-control" placeholder="Enter Password" ng-model="vm.password" required=""><br>
		<span ng-show="form.password.$dirty && form.password.$error.required" class="help-block">Password is required</span><br>
		<input class="btn btn-lg btn-primary btn-block" type="submit" ng-disabled="form.$invalid || vm.dataLoading" value="Sign in"><br>
    <a href="#/register">New here? Click me to Register</a>
	</form>

</div>
</div>
