package com.reflexis.project8;

import java.util.ArrayList;
import java.sql.*;

public class CustomerDAOImplementation implements CustomerDAO{
	
	public ArrayList<Customer> getAllCustomers() {
		ArrayList<Customer> custList=new ArrayList<Customer>();
		
		
	    Statement statement = null; // query statement
	    ResultSet resultSet = null; // manages results
	    Connection myConnection = ConnectionDAO.getConn();
	    
	    
	    try{
		
		// create Statement for querying database
        statement = myConnection.createStatement();
        
        // query database                                        
        resultSet = statement.executeQuery(            
           "SELECT * FROM customer" );
        
        // process query results
        ResultSetMetaData metaData = resultSet.getMetaData();
        int numberOfColumns = metaData.getColumnCount();     
        System.out.println( "Data from Customer Table:\n" );
        
        for ( int i = 1; i <= numberOfColumns; i++ )
           System.out.printf( "%-8s\t", metaData.getColumnName( i ) );
        System.out.println();
        
        while ( resultSet.next() ) 
        {
           for ( int i = 1; i <= numberOfColumns; i++ )
              System.out.printf( "%-8s\t", resultSet.getObject( i ) );
           System.out.println();
        } // end while
     }  // end try
     catch ( SQLException sqlException )                                
     {                                                                  
        sqlException.printStackTrace();
     } // end catch    
	  /*catch ( ClassNotFoundException cnfe)                                
     {                                                                  
        cnfe.printStackTrace();
     } // end catch*/    
	     
     finally // ensure resultSet, statement and connection are closed
     {                                                             
        try                                                        
        {                                                          
           resultSet.close();                                      
           statement.close();                                      
           myConnection.close();                                     
        } // end try                                               
        catch ( Exception exception )                              
        {                                                          
           exception.printStackTrace();                            
        } // end catch                                             
     } // end finally                                              
  		
		return custList;
	}
	
	//-----------------------------------------------------------------------------------------
	//-----------------------------------------------------------------------------------------
	
	public int  addCustomer(Customer cust)
	{
		Statement statement = null;
		Connection myConnection=null;
		int myInt=-1;
		
		try{ 
			myConnection= ConnectionDAO.getConn();
		statement = myConnection.createStatement();
		
		
			String qry="INSERT INTO customer (Customer_Id, Customer_Name, Customer_Address, Customer_Username, Customer_Number, Customer_Pincode) VALUES ('"+cust.getCustID()+"', '"+cust.getCustName()+"', '"+cust.getCustAddr()+"', '"+cust.getUsername()+"', "+cust.getNumber()+"', '"+cust.getPincode()+"')";
			System.out.println("qry: "+qry);
			myInt=statement.executeUpdate(qry);
		}
		catch ( SQLException sqlException )                                
	     {                                                                  
	        sqlException.printStackTrace();
	     } 
		catch ( Exception exception )                                
	     {                                                                  
	        exception.printStackTrace();
	     } 
		finally // ensure resultSet, statement and connection are closed
	     {                                                             
	        try                                                        
	        {                                                          
	                                                
	           statement.close();                                      
	           myConnection.close();                                     
	        } // end try                                               
	        catch ( Exception exception )                              
	        {                                                          
	           exception.printStackTrace();                            
	        } // end catch                                             
	     } // end finally                                              
	  		
			return myInt;
		
	}
	
}
