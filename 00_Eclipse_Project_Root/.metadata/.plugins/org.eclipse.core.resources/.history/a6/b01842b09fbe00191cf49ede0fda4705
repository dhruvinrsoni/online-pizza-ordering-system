        </div>
        <div class="textpizza"  style="padding-bottom: 10px;">
            <h1 style=" color: #FF7C00;">&nbspDouble Cheese Margherita </h1><br>
            <span>The ever-popular Margherita - loaded with extra cheese... oodies of it!</span><br><br><br>
            <input type="number"  name="dcmargherita" min="0" style="width:50px;" ng-model="vm.order1.dcmargherita" class="form-control" id="dcmargherita"/>
        </div>
    </fieldset>
    <br>
    <fieldset class="field">
        <div class="image">
           <img src="static/images/Farmhouse.jpg" style="height:21%">
        </div>
        <div class="textpizza"  style="padding-bottom: 10px;">
            <h1 style=" color: #FF7C00;">&nbspFarm House </h1><br>
            <span>A pizza that goes ballistic on veggies!</span><br><br><br>
              <input type="number"   name="farmhouse" min="0" style="width:50px;" ng-model="vm.order1.farmhouse" class="form-control" id="farmhouse"/>
        </div>
    </fieldset>
    <br>
    <fieldset class="field">
        <div class="image">
           <img src="static/images/Deluxe_Veggie.jpg" style="height:21%">
        </div>
        <div class="textpizza"  style="padding-bottom: 10px;">
