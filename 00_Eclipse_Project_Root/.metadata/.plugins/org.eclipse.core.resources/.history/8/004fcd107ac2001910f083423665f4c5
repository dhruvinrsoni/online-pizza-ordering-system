<script src="https://cdnjs.cloudflare.com/ajax/libs/angular.js/1.4.7/angular.min.js"></script>


<head >

  

  <title>Kitchen Staff</title>
  <style>
      @import url('https://fonts.googleapis.com/css?family=Cedarville+Cursive');
	div{
		color:white;	
	}
    .done {
      background-color: rgba(50, 153, 0, 0.7);
      color: white;
    }
    .pending {
      background-color: rgba(135, 31, 2, 0.7);
      color:white;
    }
    .readyfordelivery {
      background-color: rgba(42, 110, 178, 0.7);
      color:white;
    }
    .delivered {
      background-color: rgba(8, 84, 32, 0.7);
      color:white;
    }

  </style>
</head>



  <div >
  <b><span ng-bind="vm.items"  style="color:white;"></span></b>
    <div style="float:left;"></div>
    <div style="float: right">
      <div class="address">
      <span> We are one of the top pizza guys in whole India.<br> We came here to make a living, and ended up<br>making god's food:</span>
      </div>

      
    </div>
  </div>
  <br><br><br><br><br><br><br><br><br>
  <hr class="style2">
<div ng-class="getTheme(theme)" style="margin:-11px; min-height:733px;">
  <input type="button" ng-click="theme=!theme" value="Change Theme" style="float:left; margin:14px; width: 10%; background-color: #1E1E20; color: white; border: single white; border-radius: 4px;">
  <div style="margin: auto;width:80% ; padding-top: 10px">
    <h3><br>All Orders</h3>
    <div ng-repeat="order in orders"
       ng-class="getorderClass(order.done)">
      <span style="    font-size: 17px;    color:white;"> &nbsp {{order.serialKey}}. &nbsp&nbsp OrderID: &nbsp {{order.orderid}} &nbsp&nbsp Name: &nbsp {{order.name}} &nbsp&nbsp Address: &nbsp {{order.address}} &nbsp&nbsp Phone: &nbsp {{order.phone}} </span>
      <input type="checkbox" ng-model="myVar" ng-init="myVar = false" style="float:right;">
      <input type="button" ng-click="order.done=!order.done" value="Change Order Status" style="float:right; width: 15%; background-color: #1E1E20; color: white; border: single white; border-radius: 4px;">
      <div ng-if="myVar" style="margin-left:5%; font-size: 15px;    color:white;">
      <hr>
      <span style="font-size:20px; text-decoration: underline">Items Ordered</span>
      <div  ng-repeat="item in items" ng-if="getitems(order.orderid,item.orderid)">
      <span> {{item.item}} <br></span>
      </div>
      <hr>
      </div>
    </div>

      <h3>Completed Orders</h3>

    <div ng-repeat="order in orders" ng-class="getorderClass(order.done)">
      <span ng-show="order.done"  style="font-family: Café Françoise, cursive;    font-size: 17px;    color:white;"> &nbsp {{order.serialKey}} &nbsp&nbsp OrderID: &nbsp {{order.orderid}} &nbsp&nbsp Name: &nbsp {{order.name}} &nbsp&nbsp Address: &nbsp {{order.address}} &nbsp&nbsp Phone: &nbsp {{order.phone}} </span>

    </div>

      <h3>Pending Orders<br></h3>

    <div ng-repeat="order in orders" ng-class="getorderClass(order.done)">
      <span ng-show="!order.done" style="font-family: Café Françoise, cursive;    font-size: 17px;    color:white;"> &nbsp {{order.serialKey}} &nbsp&nbsp OrderID: &nbsp {{order.orderid}} &nbsp&nbsp Name: &nbsp {{order.name}} &nbsp&nbsp Address: &nbsp {{order.address}} &nbsp&nbsp Phone: &nbsp {{order.phone}}</span>

    </div>
  </div>
</div>
