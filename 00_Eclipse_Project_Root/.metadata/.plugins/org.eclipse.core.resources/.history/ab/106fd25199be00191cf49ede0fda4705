<link rel="stylesheet" type="text/css"  href="static/css/register.css">
<div class="col-md-6 col-md-offset-3"id="register_form" style="background:rgba(0,0,0,0.1); height:100%;">


    <form name="form" ng-submit="vm.register()" role="form" style=" margin-top: 10%; text-align: center; position:absolute; top:40%; left:50%; -ms-transform: translateX(-50%) translateY(-50%);
    -webkit-transform: translate(-50%,-50%); transform: translate(-50%,-50%);">
      <h1 style="font-family: Alegreya SC; color: #FF7C00; font-size: 70px; margin-bottom: -10px;">Register</h1>
         <div class="form-group">
            <input type="text" ng-model="vm.user.name" class="form-control" name="name" id="name" placeholder="Enter Name" required/>
            <span ng-show="form.name.$dirty && form.name.$error.required" >Name is required</span>
        </div>
        <div class="form-group">
            <input type="text" name="address" ng-model="vm.user.address" class="form-control" id="address" placeholder="Enter Address" required/>
            <span ng-show="form.address.$dirty && form.address.$error.required" >Address is required</span>
        </div>
        <div class="form-group">
            <input type="email" name="email" ng-model="vm.user.email" class="form-control" id="emailAddress"  placeholder="Enter Email" required/>
            <span ng-show="form.email.$dirty && form.email.$error.required" >Email is required</span>
        </div>
        <div class="form-group">
            <input type="password" name="password" ng-model="vm.user.password" class="form-control" id="password" placeholder="Enter Password" required/>
            <span ng-show="form.password.$dirty && form.password.$error.required" >Password is required</span>
        </div>

         <div class="form-group">
            <input type="text" name="mobileNum" ng-model="vm.user.mobileNum" class="form-control" id="mobileNum" placeholder="Enter Mobile Number" required/>
            <span ng-show="form.mobileNum.$dirty && form.mobileNum.$error.required" >Mobile Number is required</span>
        </div>
        <div class="form-group">

            <ul>
                <li>
                  <label for="gender" style=" color: #292929; font-size: 30px;">Gender</label>
                </li>
                <li>

                  <label class="custom-control-label" for="maleRadio">Male</label>
                  <input type="radio" name = "gender" id="maleRadio" ng-model = "vm.user.gender" ng-true-value = "Male" ng-false-value = "null" name="customRadioInline1" class="custom-control-input">

                </li>
                <li>

                  <label class="custom-control-label" for="femaleRadio">Female</label>
                  <input type="radio" name = "gender" id="femaleRadio" name="customRadioInline1" class="custom-control-input" ng-model = "vm.user.gender" ng-true-value = "Female" ng-false-value = "null">

                </li>
                </ul>
                
        </div>
        <div class="form-actions">
            <input type="submit" class="btn btn-primary" value="Register">
            <a href="#/">Cancel</a>
        </div>
    </form>
</div>
